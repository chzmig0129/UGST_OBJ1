# ─────────────────────────────────────────────────────────────────────────────
# UGST_OBJ1 / VALGEOUGST — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────────────────

# Which config class to use: development | production | testing
FLASK_ENV=development

# Secret key for session signing and CSRF protection.
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (used by ProductionConfig).
# Leave unset in development to use the default SQLite database.
DATABASE_URL=postgresql://valgeougst:password@localhost:5432/valgeougst

# ── File Uploads ─────────────────────────────────────────────────────────────

# Directory where uploaded files are stored (relative to project root).
UPLOAD_FOLDER=uploads

# Maximum allowed upload size in bytes (default: 16777216 = 16 MB).
MAX_CONTENT_LENGTH=16777216
